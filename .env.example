# Names only. Copy to contracts/.env (gitignored; forge loads it automatically) and fill in. Never commit real values.
# Leave optional variables commented out instead of empty (forge cannot parse an empty address/uint).
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
OWNER=0x6998E1ebdB53A243D9D61Bb88C4426f42DF784D5
TREASURY=0x6998E1ebdB53A243D9D61Bb88C4426f42DF784D5
UTILITY_TOKEN=0xaa7cd9515df27f8947ace7c3eafe5a441818e828
SCAN_PRICE=1000000000000000000000
# ORACLE=0x...                 (required for Deploy.s.sol)
# AUDITOR=0x...                (ERC-7512 signer, default ORACLE)
# DEPLOY_ATTESTATIONS=true
# IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# VALIDATION_REGISTRY=0x...    (reuse an existing one instead of deploying)
# AGENT_ID=                    (judge agentId from RegisterAgents.s.sol)
# AGENT_URIS=ipfs://...,ipfs://...
# SCAN_CHAINS=eip155:1,eip155:42161,eip155:8453,solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
